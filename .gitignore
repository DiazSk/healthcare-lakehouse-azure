data/
powerbi/data/
*.parquet

# Local venv
.venv-local/

# graft tool cache
graft/.cache/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# Agent working files — instructions, specs and tooling config for Claude, not
# public docs. Kept locally; deliberately not part of the published repository.
CLAUDE.md
context/
.claude/
.ignore

# Personal working material — article drafts, resume copy, interview notes.
# Mine, not documentation for anyone reading this repo.
writing/

# Subagent-driven-development scratch: ledger, briefs, review packages.
.superpowers/

# docs/data/*.parquet is deliberately COMMITTED, not ignored: GitHub Pages can
# only serve files present in the repo. Regenerate with
# pipeline/build_explorer_data.py. (63.5 MB, well inside Pages' 1 GB limit.)
# These are matched by the bare `data/` rule above (line 26), which matches a
# directory named "data" at any depth -- NOT by *.parquet (verify with
# `git check-ignore -v docs/data/anything`). Negate both the directory and the
# files so a future docs/data/manifest.json isn't silently skipped too.
!/docs/data/
!/docs/data/*.parquet
